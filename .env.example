# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-key-here

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
# Provided by Supabase - used for server-side operations
POSTGRES_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres:password@db.supabase.co:6543/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DATABASE=postgres
POSTGRES_HOST=db.supabase.co

# ============================================================================
# Google Gemini AI Configuration
# ============================================================================
# Get your free API key from https://makersuite.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSy...your-google-gemini-api-key-here...

# ============================================================================
# Optional: Vercel Deployment Settings
# ============================================================================
# Only needed if deploying to Vercel
# VERCEL_URL=https://your-app.vercel.app

# ============================================================================
# Feature Flags (Optional)
# ============================================================================
# Enable/disable specific features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_EXPERIMENTS=false
