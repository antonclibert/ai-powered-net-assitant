# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-key-here

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
# Provided by Supabase - used for server-side operations
POSTGRES_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres:password@db.supabase.co:6543/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DATABASE=postgres
POSTGRES_HOST=db.supabase.co

# ============================================================================
# AI Provider Configuration
# ============================================================================
# For OpenAI (recommended via Vercel AI Gateway)
OPENAI_API_KEY=sk-proj-...your-openai-api-key-here...

# Alternative: Use Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...your-anthropic-api-key-here...

# Alternative: Use Groq for faster inference
# GROQ_API_KEY=gsk_...your-groq-api-key-here...

# ============================================================================
# Optional: Vercel Deployment Settings
# ============================================================================
# Only needed if deploying to Vercel
# VERCEL_URL=https://your-app.vercel.app

# ============================================================================
# Feature Flags (Optional)
# ============================================================================
# Enable/disable specific features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_EXPERIMENTS=false
